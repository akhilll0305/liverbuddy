# Copy to .env and adjust. All settings use the LB_ prefix (see src/liverbuddy/config.py).

# LLM provider: ollama (local, default) | gemini (cloud) | fake (tests)
LB_LLM_PROVIDER=ollama
LB_OLLAMA_URL=http://localhost:11434
LB_OLLAMA_CHAT_MODEL=qwen2.5:7b
LB_OLLAMA_VISION_MODEL=qwen2.5vl:3b
LB_OLLAMA_EMBED_MODEL=nomic-embed-text

# Gemini (optional). Indexes must be rebuilt (`liverbuddy build-index`) when switching embedding providers.
# LB_GEMINI_API_KEY=
# LB_GEMINI_CHAT_MODEL=gemini-2.5-flash
# LB_GEMINI_EMBED_MODEL=gemini-embedding-001

# Security: set a long random secret in any shared deployment
# LB_JWT_SECRET=
# LB_DATABASE_URL=postgresql+psycopg://user:pass@host/liverbuddy
